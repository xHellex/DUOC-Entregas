CREATE OR REPLACE TRIGGER trg_atencion_check_medico_esp 
    BEFORE INSERT OR UPDATE ON ATENCION 
    FOR EACH ROW 
DECLARE
  v_esp NUMBER;
BEGIN
  SELECT id_especialidad INTO v_esp FROM MEDICO WHERE rut_medico = :NEW.rut_medico;
  IF v_esp IS NULL THEN
    RAISE_APPLICATION_ERROR(-20003, 'Médico sin especialidad registrada.');
  ELSIF v_esp != :NEW.id_especialidad THEN
    RAISE_APPLICATION_ERROR(-20004, 'La especialidad de la atención no coincide con la especialidad del médico.');
  END IF;
EXCEPTION
  WHEN NO_DATA_FOUND THEN
    RAISE_APPLICATION_ERROR(-20005, 'Médico no existe.');
END; 
/

CREATE OR REPLACE TRIGGER trg_medico_no_double_booking 
    BEFORE INSERT OR UPDATE ON ATENCION 
    FOR EACH ROW 
DECLARE
  v_count NUMBER;
BEGIN
  SELECT COUNT(*) INTO v_count FROM ATENCION a
    WHERE a.rut_medico = :NEW.rut_medico
      AND a.fecha_hora = :NEW.fecha_hora
      AND a.id_atencion != NVL(:NEW.id_atencion,-1);

  IF v_count > 0 THEN
    RAISE_APPLICATION_ERROR(-20002, 'Conflicto de agenda: el médico ya tiene una atención en ese horario.');
  END IF;
END; 
/

CREATE OR REPLACE TRIGGER trg_medico_no_self_supervisor 
    BEFORE INSERT OR UPDATE ON MEDICO 
    FOR EACH ROW 
BEGIN
  IF :NEW.rut_supervisor IS NOT NULL AND :NEW.rut_supervisor = :NEW.rut_medico THEN
    RAISE_APPLICATION_ERROR(-20001, 'Un médico no puede ser su propio supervisor.');
  END IF;
END; 
/

CREATE OR REPLACE TRIGGER trg_solicitud_exam_result_dates 
    BEFORE INSERT OR UPDATE ON SOLICITUD_EXAMEN 
    FOR EACH ROW 
BEGIN
  IF :NEW.estado = 'completado' AND :NEW.fecha_resultado IS NULL THEN
    RAISE_APPLICATION_ERROR(-20006, 'Si el estado es COMPLETADO, fecha_resultado debe tener valor.');
  END IF;

  IF :NEW.fecha_resultado IS NOT NULL AND :NEW.estado != 'completado' THEN
    RAISE_APPLICATION_ERROR(-20007, 'Si existe fecha_resultado, el estado debe ser COMPLETADO.');
  END IF;
END; 
/



