CREATE TABLE SOLICITUD_EXAMEN_JN
 (JN_OPERATION CHAR(3) NOT NULL
 ,JN_ORACLE_USER VARCHAR2(30) NOT NULL
 ,JN_DATETIME DATE NOT NULL
 ,JN_NOTES VARCHAR2(240)
 ,JN_APPLN VARCHAR2(35)
 ,JN_SESSION NUMBER(38)
 ,id_solicitud NUMBER NOT NULL
 ,id_atencion NUMBER NOT NULL
 ,id_examen NUMBER NOT NULL
 ,estado VARCHAR2 (20) NOT NULL
 ,resultado VARCHAR2 (4000)
 ,fecha_resultado DATE
 );

CREATE OR REPLACE TRIGGER SOLICITUD_EXAMEN_JNtrg
  AFTER 
  INSERT OR 
  UPDATE OR 
  DELETE ON SOLICITUD_EXAMEN for each row 
 Declare 
  rec SOLICITUD_EXAMEN_JN%ROWTYPE; 
  blank SOLICITUD_EXAMEN_JN%ROWTYPE; 
  BEGIN 
    rec := blank; 
    IF INSERTING OR UPDATING THEN 
      rec.id_solicitud := :NEW.id_solicitud; 
      rec.id_atencion := :NEW.id_atencion; 
      rec.id_examen := :NEW.id_examen; 
      rec.estado := :NEW.estado; 
      rec.resultado := :NEW.resultado; 
      rec.fecha_resultado := :NEW.fecha_resultado; 
      rec.JN_DATETIME := SYSDATE; 
      rec.JN_ORACLE_USER := SYS_CONTEXT ('USERENV', 'SESSION_USER'); 
      rec.JN_APPLN := SYS_CONTEXT ('USERENV', 'MODULE'); 
      rec.JN_SESSION := SYS_CONTEXT ('USERENV', 'SESSIONID'); 
      IF INSERTING THEN 
        rec.JN_OPERATION := 'INS'; 
      ELSIF UPDATING THEN 
        rec.JN_OPERATION := 'UPD'; 
      END IF; 
    ELSIF DELETING THEN 
      rec.id_solicitud := :OLD.id_solicitud; 
      rec.id_atencion := :OLD.id_atencion; 
      rec.id_examen := :OLD.id_examen; 
      rec.estado := :OLD.estado; 
      rec.resultado := :OLD.resultado; 
      rec.fecha_resultado := :OLD.fecha_resultado; 
      rec.JN_DATETIME := SYSDATE; 
      rec.JN_ORACLE_USER := SYS_CONTEXT ('USERENV', 'SESSION_USER'); 
      rec.JN_APPLN := SYS_CONTEXT ('USERENV', 'MODULE'); 
      rec.JN_SESSION := SYS_CONTEXT ('USERENV', 'SESSIONID'); 
      rec.JN_OPERATION := 'DEL'; 
    END IF; 
    INSERT into SOLICITUD_EXAMEN_JN VALUES rec; 
  END; 
